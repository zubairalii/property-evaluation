SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# OpenRouter API key (https://openrouter.ai/keys). Put your key here even though the var name says OPENAI.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=google/gemini-2.5-flash
# Used as OpenRouter HTTP-Referer / X-Title. Set per environment (local, staging, production).
# Must be an absolute URL (http:// or https://). A blank value falls back to http://localhost:5000.
OPENROUTER_APP_URL=http://localhost:5000
OPENROUTER_APP_NAME=Smart Property Evaluator
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_AUDIENCE=authenticated
